<?xml version="1.0" encoding="utf-8" ?>
<component name="AmbientScreen" extends="Group">
  <interface>
    <field id="items" type="array" onChange="OnItems" />
    <field id="active" type="boolean" value="false" onChange="OnActive" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
  <script type="text/brightscript" uri="AmbientScreen.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000ff" />
    <!-- 10% larger than the screen: the slow pan never uncovers an edge. -->
    <Poster id="ambArtA" translation="[-96,-54]" width="2112" height="1188" loadDisplayMode="scaleToZoom" opacity="0" />
    <Poster id="ambArtB" translation="[-96,-54]" width="2112" height="1188" loadDisplayMode="scaleToZoom" opacity="0" />
    <Rectangle id="ambShade" width="1920" height="1080" color="0x00000066" />
    <Group id="ambCaption" opacity="0">
      <Poster id="ambLogo" translation="[96,700]" width="620" height="180" loadDisplayMode="scaleToFit" visible="false" />
      <Label id="ambTitle" translation="[96,720]" width="1100" height="160" wrap="true" maxLines="2" vertAlign="bottom" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="64" /></Label>
      <Label id="ambMeta" translation="[96,900]" width="1100" height="40" color="0xe6e6e6ff"><Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" /></Label>
    </Group>
    <Label id="ambClock" translation="[1424,72]" width="400" height="80" horizAlign="right" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="64" /></Label>
    <Label id="ambDate" translation="[1224,150]" width="600" height="40" horizAlign="right" color="0xe0e0e0ff"><Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="26" /></Label>
    <Timer id="ambSlideTimer" duration="12" repeat="true" />
    <Timer id="ambClockTimer" duration="20" repeat="true" />
    <Timer id="ambCaptionTimer" duration="0.7" repeat="false" />
    <Animation id="ambFade" duration="1.6" easeFunction="inOutCubic">
      <FloatFieldInterpolator id="ambFadeIn" key="[0,1]" keyValue="[0,1]" fieldToInterp="ambArtA.opacity" />
      <FloatFieldInterpolator id="ambFadeOut" key="[0,1]" keyValue="[1,0]" fieldToInterp="ambArtB.opacity" />
      <FloatFieldInterpolator id="ambCaptionFade" key="[0,0.35,0.65,1]" keyValue="[1,0,0,1]" fieldToInterp="ambCaption.opacity" />
    </Animation>
    <Animation id="ambDrift" duration="14" easeFunction="linear">
      <Vector2DFieldInterpolator id="ambDriftPan" key="[0,1]" keyValue="[[-176,-90],[-16,-18]]" fieldToInterp="ambArtA.translation" />
    </Animation>
  </children>
</component>
