<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="ShowCard" />
    <field id="focusPercent" type="float" onChange="ShowFocus" />
    <field id="rowFocusPercent" type="float" onChange="ShowFocus" />
    <field id="rowListHasFocus" type="boolean" onChange="ShowFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
  <script type="text/brightscript" uri="PosterCard.brs" />
  <children>
    <Group id="card" translation="[12,12]">
      <Poster id="shadow" translation="[-48,-48]" width="436" height="287" uri="pkg:/images/card-shadow-landscape.png" visible="false" />
      <Rectangle id="placeholder" width="340" height="191" color="0x242424ff" />
      <Label id="fallback" translation="[24,62]" width="292" height="80" wrap="true" maxLines="2" color="0x999999ff" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" /></Label>
      <Label id="initials" width="176" height="176" horizAlign="center" vertAlign="center" color="0x8e8e93ff" visible="false"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="54" /></Label>
      <Poster id="poster" width="340" height="191" loadDisplayMode="scaleToZoom" />
      <Poster id="titleShade" translation="[0,76]" width="340" height="115" uri="pkg:/images/bottom-shade.png" loadDisplayMode="scaleToFill" opacity="0.9" visible="false" />
      <Poster id="titleArt" loadWidth="204" loadHeight="69" loadDisplayMode="scaleToFit" visible="false" />
      <Label id="titleName" translation="[16,113]" width="300" height="64" wrap="true" maxLines="2" vertAlign="bottom" color="0xffffffff" visible="false"><Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="26" /></Label>
      <Group id="badge" visible="false">
        <Rectangle id="badgeBg" width="34" height="34" color="0x000000b8" />
        <Poster id="badgeCheck" translation="[6,6]" width="22" height="22" uri="pkg:/images/icons/check.png" blendColor="0xffffffff" visible="false" />
        <Label id="badgeCount" width="34" height="34" horizAlign="center" vertAlign="center" color="0x111111ff" visible="false"><Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="19" /></Label>
      </Group>
      <Rectangle id="track" translation="[0,185]" width="340" height="6" color="0xffffff55" visible="false" />
      <Rectangle id="progress" translation="[0,185]" height="6" color="0xffffffff" visible="false" />
      <Label id="title" translation="[0,207]" width="340" height="40" color="0xb8b8b8ff"><Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" /></Label>
      <Label id="role" translation="[-12,222]" width="200" height="30" horizAlign="center" color="0x8e8e93ff" visible="false"><Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="21" /></Label>
    </Group>
    <Animation id="focusMotion" duration="0.16" easeFunction="outCubic" repeat="false">
      <Vector2DFieldInterpolator id="focusScale" key="[0,1]" keyValue="[[1,1],[1,1]]" fieldToInterp="card.scale" />
    </Animation>
  </children>
</component>
