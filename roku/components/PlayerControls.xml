<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerControls" extends="Group">
  <interface>
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="options" type="assocarray" onChange="OptionsChanged" />
    <field id="subtitle" type="string" alias="playerSubtitle.text" />
    <field id="title" type="string" alias="playerTitle.text" />
    <field id="position" type="float" onChange="UpdateTimeline" />
    <field id="duration" type="float" onChange="UpdateTimeline" />
    <field id="playbackState" type="string" onChange="StateChanged" />
    <field id="message" type="string" onChange="MessageChanged" />
    <field id="artwork" type="string" onChange="ArtworkChanged" />
    <field id="busy" type="boolean" value="false" onChange="BusyChanged" />
    <field id="segments" type="array" onChange="SegmentsChanged" />
    <field id="hasNextEpisode" type="boolean" value="false" onChange="UpdateSkip" />
    <field id="upNext" type="assocarray" />
    <field id="upNextArmed" type="boolean" value="false" />
    <field id="trickplay" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/Icons.brs" />
  <script type="text/brightscript" uri="PlayerControls.brs" />
  <children>
    <!-- Until the first frame: the title's art, dimmed, under a centred indicator. -->
    <Group id="loadingLayer" visible="false">
      <Poster id="loadingArt" width="1920" height="1080" loadDisplayMode="scaleToZoom" visible="false" />
      <Rectangle id="loadingShade" width="1920" height="1080" color="0x000000ff" opacity="0.62" />
      <LoadingIndicator id="loadingIndicator" translation="[960,500]" />
    </Group>
    <Animation id="loadingFadeOut" duration="0.4" easeFunction="outCubic">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="loadingLayer.opacity" />
    </Animation>
    <Poster id="skipScrim" translation="[0,600]" width="1920" height="480" uri="pkg:/images/bottom-shade.png" loadDisplayMode="scaleToFill" opacity="0" visible="false" />
    <Group id="hud">
      <Rectangle id="shade" translation="[0,640]" width="1920" height="440" color="0x000000c0" />
      <Label id="messageLabel" translation="[80,706]" width="1440" height="40" color="0xe1e1e1ff"><Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" /></Label>
      <Label id="playerSubtitle" translation="[80,758]" width="1100" height="34" color="0xd8d8d8ff"><Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="24" /></Label>
      <Label id="playerTitle" translation="[80,790]" width="1180" height="70" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="50" /></Label>
      <Group id="buttons" />
      <Rectangle id="timelineTrack" translation="[80,898]" width="1760" height="8" color="0xffffff4d" />
      <Rectangle id="timelineFill" translation="[80,898]" width="0" height="8" color="0xffffffff" />
      <Rectangle id="playhead" translation="[80,892]" width="4" height="20" color="0xffffffff" />
      <Label id="elapsed" translation="[80,920]" width="160" height="34" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" /></Label>
      <Poster id="pausedIcon" translation="[160,925]" width="24" height="24" loadDisplayMode="scaleToFit" uri="pkg:/images/icons/pause.png" visible="false" />
      <Label id="remaining" translation="[1610,920]" width="230" height="34" horizAlign="right" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" /></Label>
      <!-- Scrubbing preview: one thumbnail cut from a Jellyfin trickplay sheet. -->
      <Group id="trickFrame" visible="false">
        <Rectangle id="trickEdge" translation="[-3,-3]" width="326" height="186" color="0xffffffff" />
        <Rectangle id="trickBack" width="320" height="180" color="0x1c1c1eff" />
        <Group id="trickClip" clippingRect="[0,0,320,180]">
          <Poster id="trickSheet" loadDisplayMode="noScale" />
        </Group>
      </Group>
      <Label id="scrubStatus" translation="[690,920]" width="540" height="36" horizAlign="center" color="0xffffffff" visible="false"><Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="22" /></Label>
    </Group>
    <Group id="skipPill" translation="[1500,1080]" opacity="0" visible="false">
      <!-- Up next: the episode's still and label ride above the pill. -->
      <Group id="upNextCard" translation="[0,-276]" visible="false">
        <Rectangle id="upNextBox" width="340" height="191" color="0x2a2a2cff" />
        <Poster id="upNextArt" width="340" height="191" loadWidth="364" loadDisplayMode="scaleToZoom" />
        <Rectangle id="upNextTrack" translation="[12,177]" width="316" height="6" color="0xffffff55" />
        <Rectangle id="upNextFill" translation="[12,177]" width="0" height="6" color="0xffffffff" />
        <Label id="upNextLabel" translation="[0,203]" width="340" height="34" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="22" /></Label>
      </Group>
      <Rectangle id="skipPillBg" width="340" height="64" color="0xffffffff" />
      <Label id="skipPillLabel" width="340" height="64" horizAlign="center" vertAlign="center" color="0x111111ff"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" /></Label>
    </Group>
    <Animation id="skipMotion" duration="0.5" easeFunction="outQuintic">
      <Vector2DFieldInterpolator id="skipRise" key="[0.0, 1.0]" keyValue="[[1500,1080],[1500,964]]" fieldToInterp="skipPill.translation" />
      <FloatFieldInterpolator id="skipFade" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="skipPill.opacity" />
      <FloatFieldInterpolator id="skipScrimFade" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="skipScrim.opacity" />
    </Animation>
    <Animation id="upNextMotion" duration="1" easeFunction="linear">
      <FloatFieldInterpolator id="upNextGrow" key="[0.0, 1.0]" keyValue="[0.0, 0.0]" fieldToInterp="upNextFill.width" />
    </Animation>
    <Group id="menu" translation="[1180,262]" visible="false">
      <Rectangle id="menuPanel" width="660" height="490" color="0x2c2c2ef2" />
      <Label id="menuTitle" translation="[30,22]" width="600" height="48" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="29" /></Label>
      <Group id="menuRows" translation="[16,86]" />
      <Label id="menuPage" translation="[30,447]" width="600" height="26" color="0xaaaaaaff"><Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="18" /></Label>
    </Group>
    <Label id="controlHint" visible="false" text="" />
    <Timer id="scrubTimer" duration="0.2" repeat="true" />
    <Timer id="hideTimer" duration="6" repeat="false" />
  </children>
</component>
