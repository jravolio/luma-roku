<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group">
  <interface>
    <!-- Output {query, offset}: debounced, at most one outstanding; the Scene owns the Task and requestId. -->
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- Input {query, offset, ok, content, total, message}: responses for any other query are discarded. -->
    <field id="response" type="assocarray" alwaysNotify="true" onChange="OnSearchResponse" />
    <!-- Output: the result card chosen with OK. -->
    <field id="selected" type="node" alwaysNotify="true" />
    <!-- Output: "keyboard" or "results"; restored when the page regains focus. -->
    <field id="area" type="string" value="keyboard" />
    <!-- Input: plays the short entrance when the page is opened. -->
    <field id="enter" type="boolean" alwaysNotify="true" onChange="AnimateSearchIn" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/Icons.brs" />
  <script type="text/brightscript" uri="SearchScreen.brs" />
  <children>
    <Group id="surface">
      <Rectangle id="queryBox" translation="[80,92]" width="544" height="76" color="0x1f1f1fff" />
      <Label id="queryLabel" translation="[148,92]" width="456" height="76" vertAlign="center" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="34" /></Label>
      <SearchKeyboard id="keyboard" translation="[80,196]" />
      <Label id="heading" translation="[712,84]" width="1120" height="56" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="40" /></Label>
      <Label id="resultStatus" translation="[712,142]" width="1120" height="34" color="0xa8a8a8ff"><Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" /></Label>
      <MarkupGrid id="results" translation="[700,186]" itemComponentName="SearchResultCard" itemSize="[364,282]" itemSpacing="[12,8]" numColumns="3" numRows="3" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
      <Group id="message" translation="[712,300]">
        <Label id="messageTitle" width="1000" height="56" color="0xffffffff"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="38" /></Label>
        <Label id="messageBody" translation="[0,72]" width="900" height="110" wrap="true" maxLines="3" color="0xa8a8a8ff"><Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="27" /></Label>
      </Group>
    </Group>
    <Timer id="debounce" duration="0.35" repeat="false" />
    <Animation id="enterMotion" duration="0.18" easeFunction="outCubic">
      <Vector2DFieldInterpolator key="[0,1]" keyValue="[[0,10],[0,0]]" fieldToInterp="surface.translation" />
      <FloatFieldInterpolator key="[0,1]" keyValue="[0.6,1]" fieldToInterp="surface.opacity" />
    </Animation>
  </children>
</component>
